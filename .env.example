# Copy to .env.local. Never commit real values.

# Optional. Without a key, job cards use the built-in keyword matcher.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. Set claude-haiku-5-5 to compare cost against quality.
ODDJOB_CLAUDE_MODEL=

# ISO currency code. Sri Lanka is the first market. Set per country when Oddjob expands.
NEXT_PUBLIC_CURRENCY=LKR

# Needed once the database is connected (Phase 1). Service role key stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
