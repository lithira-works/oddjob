# Copy to .env.local. Never commit real values.

# Optional. Without a key, job cards use the built-in keyword matcher.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. Set claude-haiku-5-5 to compare cost against quality.
ODDJOB_CLAUDE_MODEL=

# ISO currency code. Sri Lanka is the first market. Set per country when Oddjob expands.
NEXT_PUBLIC_CURRENCY=LKR

# Database. The publishable key may reach browsers, and Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret key bypasses every access rule. Server only, and never with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# The admin account. Create all three with: npm run admin:create -- your-email
# Server only, and never with a NEXT_PUBLIC_ prefix. Empty means nobody can log in as admin.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Set when deploying: the header your host overwrites with the visitor's IP, such as x-real-ip on Vercel.
# Empty means all visitors share one rate limit.
TRUSTED_IP_HEADER=

# Identity checks stay closed until accounts, a privacy policy and reviewers exist. Set true only then.
ID_CHECKS_OPEN=
# Long random value, server only. Changing it later breaks the check for duplicate IDs.
ID_HASH_SECRET=
